# Required for Anthropic-backed chat; leave blank only when chat is not used.
ANTHROPIC_API_KEY=

# Optional: point the Anthropic client at a custom or proxy endpoint; leave blank for the SDK default.
ANTHROPIC_BASE_URL=

# Optional: User-Agent sent to the Anthropic endpoint. Defaults to a benign value
# ("yargi-asistan") because some proxies (e.g. cliproxyapi behind a WAF) block the SDK's
# default "AsyncAnthropic/Python ..." User-Agent. Override only if your endpoint needs it.
# ANTHROPIC_USER_AGENT=yargi-asistan

# UI model choices (Claude defaults shown; uncomment to override).
# MODEL_SONNET5=claude-sonnet-5
# MODEL_OPUS=claude-opus-4-8
# MODEL_HAIKU=claude-haiku-4-5-20251001

# Example: route GPT models through an Anthropic-compatible proxy.
# This example intentionally omits an API key value.
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# CHAT_MODEL=gpt-5.6-sol
# TITLE_MODEL=gpt-5.6-sol
# MODEL_SONNET5=gpt-5.6-sol
# MODEL_OPUS=gpt-5.6-luna
# MODEL_HAIKU=gpt-5.4-mini

# Application session secret; use a long, random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Registration policy: open or closed.
REGISTRATION_MODE=open

# MCP connection mode: embedded or http.
MCP_MODE=embedded

# MCP endpoint used when MCP_MODE=http.
YARGI_MCP_URL=http://127.0.0.1:8555/mcp/

# Optional: enables the BDDK and Sigorta Tahkim sources.
TAVILY_API_KEY=

# Optional: configures Brave-backed source searches.
BRAVE_API_TOKEN=

# Maximum LLM tokens allowed per user per UTC day.
DAILY_LLM_TOKEN_QUOTA=300000

# Maximum MCP tool calls allowed per user per UTC day.
DAILY_TOOL_CALL_QUOTA=300

# --- signing (e-imza) — DISABLED by default; test-only SoftHSM slice ---
# Leave SIGNING_ENABLED=false unless you are running the internal signing pilot.
# SIGNING_ENABLED=false
# SIGNING_KILL_SWITCH=false
# SIGNING_MODE=softhsm
# SIGNING_TEST_ONLY=true
# Private artifact + runtime state root (0700). Never inside data/ or SQLite.
# SIGNING_STATE_DIR=./var/signing
# SIGNING_MAX_UPLOAD_BYTES=26214400
# SIGNING_MAX_OUTPUT_BYTES=52428800
# SIGNING_PIN_WINDOW_SECONDS=90
# SIGNING_APPROVAL_TTL_SECONDS=300
# Private signer + broker transport (Unix sockets, dedicated group, peer UIDs).
# SIGNING_SIGNER_SOCKET=/run/yargi/signerd.sock
# SIGNING_BROKER_SOCKET=/run/yargi/signing-broker.sock
# SIGNING_TRANSPORT_GROUP=yargi-signing
# SIGNING_SERVICE_UID=
# SIGNING_SIGNER_UID=
# Ed25519 command-authentication key (FastAPI signs signer commands).
# SIGNING_COMMAND_KEY_PATH=./keys/fastapi-command-ed25519.pem
# SIGNING_COMMAND_KEY_ID=fastapi-cmd-1
# Pinned signerd keys ("kid:hex,kid:hex").
# SIGNING_SIGNER_COMMAND_PUBKEYS=
# SIGNING_CHALLENGE_PUBKEYS=
# Broker capability HMAC secret (required when signing is enabled).
# SIGNING_CAPABILITY_SECRET=
# SIGNING_CAPABILITY_KEY_ID=broker-cap-1
